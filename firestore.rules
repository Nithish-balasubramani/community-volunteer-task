rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOrganization() {
      return isAuthenticated() && getUserData().role == 'organization';
    }

    function isVolunteer() {
      return isAuthenticated() && getUserData().role == 'volunteer';
    }

    // 1. Users collection
    // - Any authenticated user can read public profile data
    // - Users can only write to their own profile
    // - Crucial: Users cannot change their own 'role' field
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'createdAt']);
      allow delete: if false; // Profiles cannot be directly deleted by clients
    }

    // 2. Tasks collection
    // - Anyone authenticated can read active tasks
    // - Only verified organizations can create tasks under their organizationId
    // - Only the owner organization can edit or cancel their tasks
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isOrganization() &&
        request.resource.data.organizationId == request.auth.uid &&
        request.resource.data.registeredCount == 0 &&
        request.resource.data.volunteerLimit > 0;
      allow update: if isAuthenticated() && (
        // Organization updates their own task (cannot forge registeredCount)
        (isOrganization() && resource.data.organizationId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['registeredCount']))
        ||
        // Atomic transaction counter increment/decrement during registration
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount', 'updatedAt']) &&
         request.resource.data.registeredCount <= resource.data.volunteerLimit)
      );
      allow delete: if false;
    }

    // 3. Registrations collection
    // - Volunteers can read their own registrations
    // - Organizations can read registrations for tasks they own
    // - Volunteers can create registrations only for themselves
    // - Only the host organization can update 'attendanceStatus'
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        resource.data.volunteerId == request.auth.uid ||
        resource.data.organizationId == request.auth.uid
      );
      allow create: if isVolunteer() &&
        request.resource.data.volunteerId == request.auth.uid &&
        request.resource.data.status == 'registered' &&
        request.resource.data.attendanceStatus == 'pending';
      allow update: if isAuthenticated() && (
        // Volunteer cancelling their own registration
        (resource.data.volunteerId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         request.resource.data.status == 'cancelled')
        ||
        // Host organization marking attendance
        (resource.data.organizationId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendanceStatus', 'updatedAt']))
      );
      allow delete: if false;
    }
  }
}
